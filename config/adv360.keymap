#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        ht_layer: ht_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "Hold Tap Layer Switch";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
        };

        ht_keypress: ht_keypress {
            compatible = "zmk,behavior-hold-tap";
            label = "Hold Tap Keypress";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1     &kp N2        &kp N3    &kp N4     &kp N5  &tog 4                                                                                                                  &mo 3  &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W         &kp F     &kp P      &kp B   &none                                                                                                                   &none  &kp J   &kp L   &kp U      &kp Y     &kp SEMI  &kp BSLH
&kp ESC    &kp A      &kp R         &kp S     &kp T      &kp G   &none                          &kp CAPS            &kp LEFT_ALT         &none  &none                                    &none  &kp M   &kp N   &kp E      &kp I     &kp O     &kp SQT
&kp LSHFT  &kp Z      &kp X         &kp C     &kp D      &kp V                                                      &none                &none                                                  &kp K   &kp H   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&kp LCTRL  &kp GRAVE  &kp LEFT_GUI  &kp LEFT  &kp RIGHT                  &ht_layer 1 BACKSPACE  &ht_layer 2 DELETE  &ht_layer 2 GRAVE    &none  &kp ENTER  &ht_keypress RIGHT_GUI SPACE                 &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &kp RCTRL
            >;
        };

        nav {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6                                                    &kp F7  &kp F8     &kp F9          &kp F10         &kp F11    &kp F12  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                    &trans  &kp PG_UP  &kp HOME        &kp UP          &kp END    &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans    &trans  &trans          &trans  &kp PG_DN  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT  &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                          &trans    &trans                          &trans     &trans          &trans          &trans     &trans   &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans    &trans  &trans  &trans                     &trans          &trans          &trans     &trans   &trans
            >;

            label = "Nav";
        };

        symbol {
            display-name = "Symbol";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                    &trans  &trans  &trans     &trans                &trans                 &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                    &trans  &trans  &kp MINUS  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans    &trans  &trans          &trans  &trans  &kp EQUAL  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                          &trans    &trans                          &trans  &trans     &kp COMMA             &kp DOT                &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans    &trans  &trans  &trans                  &trans     &trans                &trans                 &trans  &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                                        &trans       &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                                                  &bootloader  &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none               &none  &none    &bt BT_CLR  &none                        &none        &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none                                    &none    &none                                                 &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                                    &none  &none  &none    &none       &bl BL_TOG  &rgb_ug RGB_TOG                      &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        qwerty {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6                                                                &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12   &trans
&trans  &kp Q   &kp W   &kp E   &kp R   &kp T   &trans                                                                &trans  &kp Y   &kp U   &kp I    &kp O    &kp P     &trans
&trans  &kp A   &kp S   &kp D   &kp F   &kp G   &trans            &trans  &kp LALT    &kp RGUI  &kp RALT              &trans  &kp H   &kp J   &kp K    &kp L    &kp SEMI  &trans
&trans  &kp Z   &kp X   &kp C   &kp V   &kp B                             &trans      &trans                                  &kp N   &kp M   &trans   &trans   &trans    &trans
&trans  &trans  &trans  &trans  &trans                  &kp BSPC  &trans  &trans      &trans    &kp ENTER  &kp SPACE                  &trans  &trans   &trans   &trans    &trans
            >;

            label = "Qwerty";
        };
    };
};
